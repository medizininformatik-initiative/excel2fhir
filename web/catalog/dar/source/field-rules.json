{
  "schemaVersion": 1,
  "policy": "Semantic code lists are reviewed project decisions, not inferred HL7 prohibitions. Profile evidence is extracted from bundled definitions.",
  "semanticGroups": {
    "administrative": {
      "allowedCodes": [
        "unknown",
        "asked-unknown",
        "temp-unknown",
        "not-asked",
        "asked-declined",
        "masked",
        "not-applicable",
        "unsupported",
        "error",
        "not-permitted"
      ],
      "help": "Choose the actual reason why this personal or administrative fact is unavailable."
    },
    "clinical-time": {
      "allowedCodes": [
        "unknown",
        "temp-unknown",
        "masked",
        "unsupported",
        "error",
        "not-permitted",
        "not-applicable"
      ],
      "help": "Describes the absence of the clinical time, not whether the event occurred."
    },
    "coding": {
      "allowedCodes": [
        "unknown",
        "masked",
        "unsupported",
        "as-text",
        "error",
        "not-permitted"
      ],
      "help": "Describes missing structured coding; retain the coding system and profile slice.",
      "codeConditions": {
        "as-text": "The clinical content must actually be present in the resource narrative."
      }
    },
    "version": {
      "allowedCodes": [
        "unknown",
        "temp-unknown",
        "masked",
        "not-applicable",
        "unsupported",
        "error",
        "not-permitted"
      ],
      "help": "Describes the missing coding-system version, not the clinical event."
    },
    "status": {
      "allowedCodes": [
        "unknown",
        "temp-unknown",
        "masked",
        "unsupported",
        "error",
        "not-permitted"
      ],
      "help": "Describes a missing status. Related clinical/profile constraints still apply."
    },
    "text": {
      "allowedCodes": [
        "unknown",
        "asked-unknown",
        "temp-unknown",
        "not-asked",
        "asked-declined",
        "masked",
        "not-applicable",
        "unsupported",
        "error",
        "not-permitted"
      ],
      "help": "Describes missing descriptive information; do not use numeric error codes."
    },
    "numeric-measurement": {
      "allowedCodes": [
        "unknown",
        "asked-unknown",
        "temp-unknown",
        "not-asked",
        "asked-declined",
        "masked",
        "not-applicable",
        "unsupported",
        "error",
        "not-permitted",
        "as-text",
        "not-a-number",
        "negative-infinity",
        "positive-infinity",
        "not-performed"
      ],
      "help": "Describes the missing numeric measurement; the reason replaces the entire measurement value.",
      "codeConditions": {
        "as-text": "The measurement must actually be present in the resource narrative.",
        "not-performed": "The measurement procedure was not performed."
      }
    },
    "measurement": {
      "allowedCodes": [
        "unknown",
        "asked-unknown",
        "temp-unknown",
        "not-asked",
        "asked-declined",
        "masked",
        "not-applicable",
        "unsupported",
        "error",
        "not-permitted",
        "as-text",
        "not-performed"
      ],
      "help": "Describes the missing nonnumeric measurement; the reason replaces the entire measurement value.",
      "codeConditions": {
        "as-text": "The measurement must actually be present in the resource narrative.",
        "not-performed": "The measurement procedure was not performed."
      }
    },
    "dose": {
      "allowedCodes": [
        "unknown",
        "temp-unknown",
        "masked",
        "unsupported",
        "error",
        "not-permitted",
        "not-applicable",
        "as-text"
      ],
      "help": "Describes the absence of a structured dose, not a laboratory measurement.",
      "codeConditions": {
        "as-text": "The dose must actually be present in the resource narrative."
      }
    },
    "document-content": {
      "allowedCodes": [
        "unknown",
        "temp-unknown",
        "masked",
        "unsupported",
        "error",
        "not-permitted"
      ],
      "help": "Describes missing document bytes. URL, size and hash must be handled consistently."
    }
  },
