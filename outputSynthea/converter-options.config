# Konvertierungsoptionen für Synthea → Excel → FHIR
# Vorhandene Dateien werden nicht überschrieben.
# Aktive Angaben überschreiben die Workflow-Defaults.
# Fehlende oder auskommentierte Angaben verwenden den Workflow-Default.
# true = ja; false = nein.

# Diagnose verweist auf den zugehörigen Kontakt (Condition.encounter).
# Workflow-Default: true
SET_REFERENCE_FROM_CONDITION_TO_ENCOUNTER = true

# Kontakt verweist auf seine Diagnosen (Encounter.diagnosis).
# Workflow-Default: false
SET_REFERENCE_FROM_ENCOUNTER_TO_CONDITION = false

# Prozedur verweist auf den Kontakt (Procedure.encounter).
# Workflow-Default: true
SET_REFERENCE_FROM_PROCEDURE_CONDITION_TO_ENCOUNTER = true

# Kontakt verweist auf Prozeduren in Encounter.diagnosis.
# Workflow-Default: false
SET_REFERENCE_FROM_ENCOUNTER_TO_PROCEDURE_CONDITION = false

# Fehlende Diagnose des Unterkontakts aus dem übergeordneten Kontakt ergänzen.
# Bei false erfolgt keine automatische Diagnoseübernahme.
# Workflow-Default: false
ADD_MISSING_DIAGNOSES_FROM_SUPER_ENCOUNTER = false

# Excel-Eingaben vor der Konvertierung streng prüfen und bei Fehlern abbrechen.
# Dies ersetzt nicht die anschließende FHIR-Validierung.
# Workflow-Default: true
VALIDATE_STRICT = true

# Startwert des automatisch erzeugten ID-Zählers für Consent.
# Workflow-Default: 1
START_ID_CONSENT = 1

# Startwert des automatisch erzeugten ID-Zählers für Diagnosen.
# Workflow-Default: 1
START_ID_CONDITION = 1

# Startwert des automatisch erzeugten ID-Zählers für Abteilungskontakte.
# Workflow-Default: 1
START_ID_ENCOUNTER_LEVEL_2 = 1

# Startwert des automatisch erzeugten ID-Zählers für Versorgungsstellenkontakte.
# Workflow-Default: 1
START_ID_ENCOUNTER_LEVEL_3 = 1

# Startwert des automatisch erzeugten ID-Zählers für Verordnungen.
# Workflow-Default: 1
START_ID_MEDICATION_REQUEST = 1

# Startwert des automatisch erzeugten ID-Zählers für Verabreichungen.
# Workflow-Default: 1
START_ID_MEDICATION_ADMINISTRATION = 1

# Startwert des automatisch erzeugten ID-Zählers für Medikationsaussagen.
# Workflow-Default: 1
START_ID_MEDICATION_STATEMENT = 1

# Startwert des automatisch erzeugten ID-Zählers für Laborbefunde.
# Workflow-Default: 1
START_ID_OBSERVATION_LABORATORY = 1

# Startwert des automatisch erzeugten ID-Zählers für klinische Messwerte.
# Workflow-Default: 1
START_ID_OBSERVATION_VITAL_SIGNS = 1

# Startwert des automatisch erzeugten ID-Zählers für Prozeduren.
# Workflow-Default: 1
START_ID_PROCEDURE = 1

# Startwert des automatisch erzeugten ID-Zählers für Dokumentverweise.
# Workflow-Default: 1
START_ID_DOCUMENT_REFERENCE = 1

# Präfix vor jeder Patienten-ID; Standard ist eine leere Zeichenfolge.
# Workflow-Default: (leer)
PID_PREFIX =

# Suffix nach jeder Patienten-ID; Standard ist eine leere Zeichenfolge.
# Workflow-Default: (leer)
PID_SUFFIX =

# Anfangsversatz für die letzte Zahl in der Patienten-ID.
# Nur verwenden, wenn die ID eine passende ganzzahlige Nummer enthält.
# Workflow-Default: 0
PID_LAST_NUMBER_INCREASE_INITIAL_OFFSET = 0

# Versatz der letzten ID-Zahl je zusätzlichem Durchlauf.
# Versatz so wählen, dass keine doppelten Patienten-IDs entstehen.
# Workflow-Default: 0
PID_LAST_NUMBER_INCREASE_LOOP_OFFSET = 0

# Zusätzliche Durchläufe zur Vervielfachung des Datensatzes.
# 0 bedeutet keine zusätzlichen Durchläufe; passende ID-Versätze festlegen.
# Workflow-Default: 0
PID_LAST_NUMBER_INCREASE_LOOP_COUNT = 0
